# --- Supabase (las crea la integración de Vercel Marketplace) ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel Cron: Vercel lo manda como "Authorization: Bearer ..." ---
CRON_SECRET=

# --- GoHighLevel (API v2, Private Integration Token de la subcuenta) ---
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Secreto compartido para /api/webhooks/ghl (header x-webhook-secret o ?token=)
GHL_WEBHOOK_SECRET=

# --- Meta Marketing API ---
# Token de System User con permisos ads_read + ads_management (este último para pausar/activar campañas)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0
# Opcional: ID del custom field "Estado" de GHL. Si no se pone, se busca por nombre (scope
# locations/customFields.readonly). Si el custom field está vacío se usa el campo estándar `state`.
GHL_STATE_CUSTOM_FIELD_ID=
# Quién ve Campañas y Anuncios se configura en /accesos (team_members.can_see_ads).
# Opcional: de esos, emails (por coma) que pueden pausar/activar campañas. Vacío = todos ellos.
META_CONTROL_EMAILS=
